  name: 'steam' | 'drop-box' | 'xp' | 'medal' | 'shield-check' | 'shield-alert' | 'refresh' | 'plus' | 'settings' | 'trash' | 'edit' | 'external' | 'copy' | 'check' | 'download' | 'upload' | 'play' | 'info' | 'filter' | 'grid' | 'table';
  class?: string;
