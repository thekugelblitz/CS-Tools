---
import Icons from './Icons.astro';
---

<section id="section-hacker-radar" class="space-y-6 hidden">
  <!-- Hacker Radar Header Banner -->
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-red-950/40 via-surface-1 to-black border border-red-500/30 p-6 sm:p-8 shadow-2xl">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-red-600/10 blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-950/80 border border-red-500/30 text-red-400 font-extrabold text-xs mb-3">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
          <span>Valve Anti-Cheat AI Predictive Radar</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
          CS2 Match Hacker & Cheater Intelligence
        </h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1 max-w-2xl leading-relaxed">
          Deep behavioral heuristics analyzing sub-160ms time-to-damage, through-smoke kill ratios, erratic angle snap velocities, robotic crosshair error, and disposable Steam account trust.
        </p>
      </div>

      <!-- Quick Metrics Counters -->
      <div class="flex items-center gap-3">
        <div class="px-4 py-3 rounded-2xl bg-black/80 border border-white/[0.08] text-center min-w-[90px]">
          <span class="block text-[11px] font-bold text-zinc-500 uppercase">Matches Scanned</span>
          <span id="radar-count-matches" class="text-xl font-black font-mono text-white">3</span>
        </div>
        <div class="px-4 py-3 rounded-2xl bg-red-950/60 border border-red-500/40 text-center min-w-[90px]">
          <span class="block text-[11px] font-bold text-red-400 uppercase">Cheaters Flagged</span>
          <span id="radar-count-cheaters" class="text-xl font-black font-mono text-red-400">2</span>
        </div>
        <div class="px-4 py-3 rounded-2xl bg-emerald-950/60 border border-emerald-500/40 text-center min-w-[90px]">
          <span class="block text-[11px] font-bold text-emerald-400 uppercase">Clean Verified</span>
          <span id="radar-count-clean" class="text-xl font-black font-mono text-emerald-400">28</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Custom Player / Match Inspector Bar -->
  <div class="rounded-2xl bg-surface-1 border border-white/[0.08] p-5 shadow-lg">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2 text-white font-bold text-sm">
        <Icons name="search" class="w-4 h-4 text-emerald-400" />
        <span>Instant Hacker Scanner: Any Player or Match Share Code</span>
      </div>
      <span class="text-xs text-zinc-500 font-mono">Neural Anti-Cheat Heuristics</span>
    </div>

    <form id="form-scan-player" class="flex flex-col sm:flex-row items-center gap-3">
      <div class="relative flex-1 w-full">
        <input
          id="input-scan-target"
          type="text"
          placeholder="Paste SteamID64, Vanity URL, or Match Share Code (CSGO-xxxxx...)"
          class="w-full px-4 py-2.5 rounded-xl bg-black border border-white/[0.1] text-white text-xs placeholder:text-zinc-500 focus:outline-none focus:border-emerald-400 font-mono"
        />
      </div>

      <button
        type="submit"
        class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-extrabold text-xs transition flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(239,68,68,0.4)] cursor-pointer"
      >
        <Icons name="shield-check" class="w-4 h-4" />
        <span>Run Threat Radar Scan</span>
      </button>

      <button
        type="button"
        id="btn-scan-demo-cheater"
        class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-300 border border-white/[0.08] font-bold text-xs transition cursor-pointer"
      >
        Test Sample Flagged Player
      </button>
    </form>

    <!-- Instant Scan Result Output Container (Hidden by default) -->
    <div id="radar-live-result" class="mt-4 hidden p-4 rounded-xl border transition-all">
      <!-- Injected via JavaScript -->
    </div>
  </div>

  <!-- Recent Matches Anti-Cheat Audit Cards -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <Icons name="crosshair" class="w-4 h-4 text-red-400" />
        <h3 class="text-base font-bold text-white">Scavenged Match Anti-Cheat Audit Logs</h3>
      </div>
      <span class="text-xs text-zinc-500 font-mono">Auto-scanned across all 10 players</span>
    </div>

    <!-- Match Audit 1: Overpass CSTracker #006591 (Flagged Cheater Found on Enemy Team) -->
    <div class="rounded-2xl bg-surface-1 border border-red-500/40 p-5 shadow-[0_0_20px_-8px_rgba(239,68,68,0.2)]">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-white/[0.06] pb-3 mb-4">
        <div class="flex items-center gap-3">
          <span class="px-2.5 py-1 rounded-lg bg-red-950 text-red-400 border border-red-500/30 text-xs font-black uppercase">
            🚨 1 Flagged Cheater
          </span>
          <div>
            <h4 class="font-bold text-white text-sm">Overpass (Premier) · 13 - 1 Victory</h4>
            <span class="text-xs text-zinc-400 font-mono">CSTracker Match #006591 · Verified Demo Available</span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button
            class="btn-inspect-match-radar px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-white/[0.1] text-xs font-bold transition flex items-center gap-1.5 cursor-pointer"
            data-match-id="match-006591"
          >
            <Icons name="chart" class="w-3.5 h-3.5 text-emerald-400" />
            <span>Inspect 10-Player Scoreboard</span>
          </button>

          <a
            href="https://cstracker.gg/matches/006591"
            target="_blank"
            rel="noopener noreferrer"
            class="p-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white border border-white/[0.1] transition"
            title="Open Demo on CSTracker"
          >
            <Icons name="external" class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>

      <!-- Detected Threat Alert Box -->
      <div class="p-4 rounded-xl bg-red-950/30 border border-red-500/30 mb-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span>
            <strong class="text-red-300 text-xs">Flagged Player: xX_OneTapGod_Xx (Terrorist Side)</strong>
            <span class="px-2 py-0.5 rounded bg-red-900 text-red-100 font-mono font-black text-[10px]">86% Threat Probability</span>
          </div>
          <span class="text-[11px] text-red-400 font-mono">Sub-150ms TTK · 92.3% Headshot Rate</span>
        </div>

        <p class="text-xs text-zinc-300 leading-relaxed">
          Heuristic triggers: Abnormal 92.3% headshot ratio on 13 frags, instant 145ms reaction time, robotic 3.2° crosshair snap error, on a disposable Level 1 Steam account created 14 days ago. Suspicious kills in rounds 3, 7, and 11.
        </p>

        <div class="flex flex-wrap gap-2 mt-2.5 text-[10px] font-bold">
          <span class="px-2 py-0.5 rounded bg-red-900/60 text-red-300 border border-red-500/40">Aimbot Index: 94/100</span>
          <span class="px-2 py-0.5 rounded bg-red-900/60 text-red-300 border border-red-500/40">Wallhack Index: 82/100</span>
          <span class="px-2 py-0.5 rounded bg-red-900/60 text-red-300 border border-red-500/40">Burner Account Risk: 88/100</span>
        </div>
      </div>

      <!-- Verified Legitimate Players Box -->
      <div class="flex items-center justify-between text-xs text-zinc-400 p-2.5 rounded-xl bg-zinc-950/60 border border-white/[0.04]">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Friendly Team: <strong class="text-white">TheKugelBlitz (DJ)</strong> and 4 teammates verified 100% clean.</span>
        </div>
        <span class="text-emerald-400 font-mono text-[11px]">Clean Record (0.00% Cheat Risk)</span>
      </div>
    </div>

    <!-- Match Audit 2: Mirage Premier (High Risk Player Found) -->
    <div class="rounded-2xl bg-surface-1 border border-yellow-500/30 p-5 shadow-[0_0_20px_-8px_rgba(234,179,8,0.15)]">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 border-b border-white/[0.06] pb-3 mb-4">
        <div class="flex items-center gap-3">
          <span class="px-2.5 py-1 rounded-lg bg-yellow-950 text-yellow-400 border border-yellow-500/30 text-xs font-black uppercase">
            ⚠️ 1 High Suspicion
          </span>
          <div>
            <h4 class="font-bold text-white text-sm">Mirage (Premier) · 13 - 9 Victory</h4>
            <span class="text-xs text-zinc-400 font-mono">Premier Rating 18,400</span>
          </div>
        </div>

        <button
          class="btn-inspect-match-radar px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-white/[0.1] text-xs font-bold transition flex items-center gap-1.5 cursor-pointer"
          data-match-id="match-006592"
        >
          <Icons name="chart" class="w-3.5 h-3.5 text-emerald-400" />
          <span>Inspect 10-Player Scoreboard</span>
        </button>
      </div>

      <div class="p-4 rounded-xl bg-yellow-950/20 border border-yellow-500/30">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-400"></span>
            <strong class="text-yellow-300 text-xs">High Suspicion: Smoke_Criminal (Terrorist Side)</strong>
            <span class="px-2 py-0.5 rounded bg-yellow-900 text-yellow-100 font-mono font-black text-[10px]">72% Threat Probability</span>
          </div>
          <span class="text-[11px] text-yellow-400 font-mono">38% Through-Smoke Kills</span>
        </div>

        <p class="text-xs text-zinc-300 leading-relaxed">
          Heuristic triggers: 38% of kills occurred through volumetric smoke without prior radar ping or tag. Flank awareness timing shows 0-delay off-angle clears.
        </p>
      </div>
    </div>

    <!-- Match Audit 3: Inferno Premier (Clean Match) -->
    <div class="rounded-2xl bg-surface-1 border border-emerald-500/30 p-5 shadow-[0_0_20px_-8px_rgba(16,185,129,0.15)]">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="px-2.5 py-1 rounded-lg bg-emerald-950 text-emerald-400 border border-emerald-500/30 text-xs font-black uppercase">
            ✓ 100% Clean Match
          </span>
          <div>
            <h4 class="font-bold text-white text-sm">Inferno (Premier) · 11 - 13 Defeat</h4>
            <span class="text-xs text-zinc-400 font-mono">All 10 players verified within normal human tolerances</span>
          </div>
        </div>

        <button
          class="btn-inspect-match-radar px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-white/[0.1] text-xs font-bold transition flex items-center gap-1.5 cursor-pointer"
          data-match-id="match-006593"
        >
          <Icons name="chart" class="w-3.5 h-3.5 text-emerald-400" />
          <span>Inspect Scoreboard</span>
        </button>
      </div>
    </div>
  </div>
</section>
