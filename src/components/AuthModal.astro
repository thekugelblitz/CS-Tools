---
import Icons from './Icons.astro';
---

<div
  id="modal-auth"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/85 backdrop-blur-md hidden"
>
  <div
    class="relative w-full max-w-md rounded-2xl sm:rounded-3xl bg-zinc-950 border border-emerald-500/30 shadow-2xl overflow-hidden transition-all"
  >
    <!-- Top Modal Header -->
    <div class="relative z-10 flex items-center justify-between p-4 sm:p-6 border-b border-white/[0.08] bg-zinc-900/60">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0">
          <Icons name="user" class="w-5 h-5 text-emerald-400" />
        </div>
        <div>
          <h3 class="text-base sm:text-lg font-black text-white tracking-tight">CS2Live Account</h3>
          <p class="text-[11px] text-zinc-400">Sign in to track your personal profiles & match radar</p>
        </div>
      </div>

      <button
        id="btn-close-auth"
        class="w-8 h-8 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center border border-white/[0.08] transition cursor-pointer"
        title="Close"
      >
        <Icons name="close" class="w-4 h-4" />
      </button>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="relative z-10 flex border-b border-white/[0.08] p-1.5 bg-black/40">
      <button
        type="button"
        class="auth-tab active flex-1 py-2 text-xs font-bold rounded-xl transition bg-zinc-800 text-white cursor-pointer"
        data-mode="signin"
      >
        Sign In
      </button>
      <button
        type="button"
        class="auth-tab flex-1 py-2 text-xs font-bold text-zinc-400 hover:text-white rounded-xl transition cursor-pointer"
        data-mode="signup"
      >
        Create Account
      </button>
    </div>

    <!-- Modal Body -->
    <div class="relative z-10 p-4 sm:p-6 space-y-4">
      <!-- Sign In View -->
      <div id="auth-view-signin" class="space-y-4">
        <form id="form-sign-in" class="space-y-3">
          <div class="space-y-1">
            <label class="block text-xs font-bold text-zinc-400">Email Address</label>
            <input
              type="email"
              id="input-signin-email"
              placeholder="player@example.com"
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-white/[0.1] text-white text-xs sm:text-sm font-mono focus:border-emerald-500/50 outline-none transition"
            />
          </div>

          <div class="space-y-1">
            <label class="block text-xs font-bold text-zinc-400">Password</label>
            <input
              type="password"
              id="input-signin-password"
              placeholder="••••••••••••"
              class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-white/[0.1] text-white text-xs sm:text-sm font-mono focus:border-emerald-500/50 outline-none transition"
            />
          </div>

          <button
            type="submit"
            class="w-full py-3 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-black text-xs sm:text-sm font-extrabold transition cursor-pointer glow-emerald mt-2"
          >
            Sign In to Dashboard
          </button>
        </form>

        <div class="relative flex py-2 items-center">
          <div class="flex-grow border-t border-white/[0.08]"></div>
          <span class="flex-shrink mx-3 text-[10px] uppercase font-bold text-zinc-500">or instant session</span>
          <div class="flex-grow border-t border-white/[0.08]"></div>
        </div>

        <button
          type="button"
          id="btn-auth-quick-steam"
          class="w-full py-2.5 px-4 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-white/[0.1] text-xs font-bold transition flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-10 10c0 4.42 2.87 8.17 6.84 9.5l1.62-4.13A4 4 0 0 1 12 16a4 4 0 0 1 4 4c0 .34-.05.67-.13.98A10 10 0 0 0 12 2z"/></svg>
          <span>Continue as Guest / Steam Player</span>
        </button>
      </div>

      <!-- Create Account View -->
      <div id="auth-view-signup" class="space-y-4 hidden">
        <form id="form-sign-up" class="space-y-3">
          <div class="space-y-1">
            <label class="block text-xs font-bold text-zinc-400">Gamer Tag / Username</label>
            <input
              type="text"
              id="input-signup-username"
              placeholder="e.g. AcePlayer"
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-white/[0.1] text-white text-xs sm:text-sm font-mono focus:border-emerald-500/50 outline-none transition"
            />
          </div>

          <div class="space-y-1">
            <label class="block text-xs font-bold text-zinc-400">Email Address</label>
            <input
              type="email"
              id="input-signup-email"
              placeholder="name@example.com"
              required
              class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-white/[0.1] text-white text-xs sm:text-sm font-mono focus:border-emerald-500/50 outline-none transition"
            />
          </div>

          <div class="space-y-1">
            <label class="block text-xs font-bold text-zinc-400">SteamID64 (Optional)</label>
            <input
              type="text"
              id="input-signup-steamid"
              placeholder="76561198..."
              class="w-full px-3.5 py-2.5 rounded-xl bg-zinc-900 border border-white/[0.1] text-white text-xs sm:text-sm font-mono focus:border-emerald-500/50 outline-none transition"
            />
          </div>

          <button
            type="submit"
            class="w-full py-3 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-black text-xs sm:text-sm font-extrabold transition cursor-pointer glow-emerald mt-2"
          >
            Create Account
          </button>
        </form>
      </div>

      <!-- Sign Out Button (Visible when logged in) -->
      <div id="auth-signed-in-section" class="pt-2 border-t border-white/[0.06] text-center">
        <button
          type="button"
          id="btn-auth-sign-out"
          class="text-xs text-red-400 hover:text-red-300 font-bold transition cursor-pointer"
        >
          Sign Out of Account
        </button>
      </div>
    </div>
  </div>
</div>
