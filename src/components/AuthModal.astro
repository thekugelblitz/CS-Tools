---
import Icons from './Icons.astro';
---

<div
  id="modal-auth"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md hidden"
>
  <div
    class="relative w-full max-w-md rounded-3xl bg-zinc-950 border border-emerald-500/30 shadow-[0_0_50px_-10px_rgba(16,185,129,0.3)] overflow-hidden transition-all duration-300"
  >
    <!-- Background Glow Effect -->
    <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-emerald-600/15 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-64 h-64 rounded-full bg-cyan-600/10 blur-3xl pointer-events-none"></div>

    <!-- Modal Header -->
    <div class="relative z-10 flex items-center justify-between p-6 border-b border-white/[0.08]">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
          <Icons name="shield-check" class="w-5 h-5" />
        </div>
        <div>
          <h3 id="auth-modal-title" class="text-lg font-black text-white tracking-tight">Access DropRadar Intel</h3>
          <p class="text-xs text-zinc-400">Track profiles, match history & weekly drop status</p>
        </div>
      </div>

      <button
        id="btn-close-auth-modal"
        class="w-8 h-8 rounded-full bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white flex items-center justify-center border border-white/[0.08] transition cursor-pointer"
      >
        <Icons name="close" class="w-4 h-4" />
      </button>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="relative z-10 flex border-b border-white/[0.08] p-1.5 bg-black/40">
      <button
        id="tab-auth-login"
        type="button"
        class="flex-1 py-2 text-xs font-bold rounded-xl transition bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 cursor-pointer"
      >
        Sign In
      </button>
      <button
        id="tab-auth-register"
        type="button"
        class="flex-1 py-2 text-xs font-bold text-zinc-400 hover:text-white rounded-xl transition cursor-pointer"
      >
        Create Account
      </button>
    </div>

    <!-- Modal Body -->
    <div class="relative z-10 p-6 space-y-4">
      <!-- One-Click Steam Profile Quick Connect -->
      <div class="p-4 rounded-2xl bg-zinc-900/60 border border-white/[0.08] space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-zinc-300">Quick Connect via Steam Profile</span>
          <span class="text-[10px] font-mono text-emerald-400 font-semibold">Instant Scavenge</span>
        </div>

        <button
          type="button"
          id="btn-quick-login-greatmahakaal"
          class="w-full px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-950 to-zinc-900 hover:from-emerald-900 hover:to-zinc-800 border border-emerald-500/40 text-left transition flex items-center justify-between group cursor-pointer"
        >
          <div class="flex items-center gap-2.5">
            <img
              src="https://avatars.akamai.steamstatic.com/bd44a769f5b88b66bb922967115499dbfdcf70b5_full.jpg"
              alt="Avatar"
              class="w-7 h-7 rounded-lg border border-emerald-500/40"
            />
            <div>
              <span class="block text-xs font-bold text-white group-hover:text-emerald-300">TheKugelBlitz</span>
              <span class="block text-[10px] text-zinc-400 font-mono">id/greatmahakaal (76561198287445170)</span>
            </div>
          </div>
          <span class="text-[11px] font-bold text-emerald-400 font-mono flex items-center gap-1">
            <span>Connect</span>
            <Icons name="arrow-right" class="w-3.5 h-3.5" />
          </span>
        </button>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-white/[0.08]"></div>
        <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">or continue with email</span>
        <div class="flex-1 h-px bg-white/[0.08]"></div>
      </div>

      <!-- Main Form -->
      <form id="form-auth-user" class="space-y-3">
        <!-- Username (visible in register mode) -->
        <div id="auth-field-username" class="hidden space-y-1">
          <label class="block text-xs font-bold text-zinc-400">Username / In-Game Tag</label>
          <input
            type="text"
            id="auth-input-username"
            placeholder="e.g. TheKugelBlitz"
            class="w-full px-4 py-2.5 rounded-xl bg-black border border-white/[0.1] text-white text-xs placeholder:text-zinc-500 focus:outline-none focus:border-emerald-400 font-medium"
          />
        </div>

        <!-- Email -->
        <div class="space-y-1">
          <label class="block text-xs font-bold text-zinc-400">Email Address / Username</label>
          <input
            type="text"
            id="auth-input-email"
            placeholder="greatmahakaal@steam.community"
            required
            class="w-full px-4 py-2.5 rounded-xl bg-black border border-white/[0.1] text-white text-xs placeholder:text-zinc-500 focus:outline-none focus:border-emerald-400 font-medium"
          />
        </div>

        <!-- Password -->
        <div class="space-y-1">
          <label class="block text-xs font-bold text-zinc-400">Password</label>
          <input
            type="password"
            id="auth-input-password"
            placeholder="••••••••••••"
            required
            class="w-full px-4 py-2.5 rounded-xl bg-black border border-white/[0.1] text-white text-xs placeholder:text-zinc-500 focus:outline-none focus:border-emerald-400 font-medium"
          />
        </div>

        <!-- Steam Profile Link (visible in register mode) -->
        <div id="auth-field-steam" class="hidden space-y-1">
          <label class="block text-xs font-bold text-zinc-400">Steam ID or Vanity URL (Optional)</label>
          <input
            type="text"
            id="auth-input-steamid"
            placeholder="76561198287445170 or greatmahakaal"
            class="w-full px-4 py-2.5 rounded-xl bg-black border border-white/[0.1] text-white text-xs placeholder:text-zinc-500 focus:outline-none focus:border-emerald-400 font-mono"
          />
        </div>

        <button
          type="submit"
          id="auth-btn-submit"
          class="w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-sm transition shadow-[0_0_20px_rgba(16,185,129,0.3)] cursor-pointer mt-2"
        >
          Sign In
        </button>
      </form>
    </div>
  </div>
</div>
