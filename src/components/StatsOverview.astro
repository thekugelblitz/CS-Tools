---
import Icons from './Icons.astro';
---

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-8">
  <!-- Card 1: Total Fleet -->
  <div class="relative overflow-hidden rounded-2xl bg-surface-1 border border-white/[0.08] p-4 sm:p-5 hover:border-white/[0.16] transition group">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold text-zinc-400">Total Accounts</span>
      <div class="p-2 rounded-xl bg-zinc-900 border border-white/[0.08] text-zinc-300 group-hover:text-white transition">
        <Icons name="steam" class="w-4 h-4" />
      </div>
    </div>
    <div class="flex items-baseline gap-2">
      <span id="stat-total-accounts" class="text-2xl sm:text-3xl font-extrabold text-white font-mono">0</span>
      <span class="text-xs text-zinc-500 font-medium">accounts</span>
    </div>
    <div class="mt-2 flex items-center gap-1.5 text-[11px] text-emerald-400">
      <Icons name="shield-check" class="w-3.5 h-3.5" />
      <span id="stat-vac-status">VAC Safe</span>
    </div>
  </div>

  <!-- Card 2: Drops Available (Ready) -->
  <div class="relative overflow-hidden rounded-2xl bg-surface-1 border border-emerald-500/20 p-4 sm:p-5 hover:border-emerald-500/40 transition group">
    <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-500/5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold text-emerald-400">Drops Ready</span>
      <div class="p-2 rounded-xl bg-emerald-950/60 border border-emerald-500/30 text-emerald-400 glow-emerald">
        <Icons name="drop-box" class="w-4 h-4" />
      </div>
    </div>
    <div class="flex items-baseline gap-2">
      <span id="stat-drops-ready" class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono">0</span>
      <span class="text-xs text-emerald-500/80 font-medium">pending</span>
    </div>
    <div class="mt-2 flex items-center gap-1.5 text-[11px] text-zinc-400">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
      <span>Care Package eligible</span>
    </div>
  </div>

  <!-- Card 3: Drops Claimed -->
  <div class="relative overflow-hidden rounded-2xl bg-surface-1 border border-yellow-500/20 p-4 sm:p-5 hover:border-yellow-500/40 transition group">
    <div class="absolute top-0 right-0 w-24 h-24 bg-yellow-500/5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold text-yellow-400">Drops Claimed</span>
      <div class="p-2 rounded-xl bg-yellow-950/60 border border-yellow-500/30 text-yellow-400 glow-gold">
        <Icons name="check" class="w-4 h-4" />
      </div>
    </div>
    <div class="flex items-baseline gap-2">
      <span id="stat-drops-claimed" class="text-2xl sm:text-3xl font-extrabold text-yellow-400 font-mono">0</span>
      <span id="stat-completion-pct" class="text-xs text-yellow-500/80 font-medium">(0%)</span>
    </div>
    <div class="mt-2 flex items-center gap-1.5 text-[11px] text-zinc-400">
      <span>Est. Value:</span>
      <strong id="stat-case-value" class="text-yellow-300 font-mono">$0.00</strong>
    </div>
  </div>

  <!-- Card 4: Service Medals Near Claim -->
  <div class="relative overflow-hidden rounded-2xl bg-surface-1 border border-purple-500/20 p-4 sm:p-5 hover:border-purple-500/40 transition group">
    <div class="absolute top-0 right-0 w-24 h-24 bg-purple-500/5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-semibold text-purple-400">Medal Prestige</span>
      <div class="p-2 rounded-xl bg-purple-950/60 border border-purple-500/30 text-purple-400 glow-purple">
        <Icons name="medal" class="w-4 h-4" />
      </div>
    </div>
    <div class="flex items-baseline gap-2">
      <span id="stat-near-medal" class="text-2xl sm:text-3xl font-extrabold text-purple-400 font-mono">0</span>
      <span class="text-xs text-purple-400/80 font-medium">at Rank 35+</span>
    </div>
    <div class="mt-2 flex items-center gap-1.5 text-[11px] text-zinc-400">
      <Icons name="xp" class="w-3.5 h-3.5 text-purple-400" />
      <span>Close to 2026 Medal</span>
    </div>
  </div>
</div>
