---
import Icons from './Icons.astro';
---

<div
  id="modal-edit-account"
  class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-md transition-opacity"
>
  <div class="relative w-full max-w-lg rounded-2xl bg-surface-1 border border-white/[0.12] shadow-2xl p-6 sm:p-7 overflow-y-auto max-h-[90vh]">
    <!-- Close button -->
    <button
      id="btn-close-edit-modal"
      class="absolute top-5 right-5 p-1.5 text-zinc-400 hover:text-white rounded-lg hover:bg-zinc-800 transition"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="6"></line>
      </svg>
    </button>

    <!-- Header -->
    <div class="flex items-center gap-3 mb-5">
      <div class="p-2.5 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400">
        <Icons name="edit" class="w-5 h-5" />
      </div>
      <div>
        <h3 class="text-lg font-bold text-white">Edit Account Status</h3>
        <p id="edit-modal-subtitle" class="text-xs text-zinc-400">Update XP, drop outcome, and medal progress</p>
      </div>
    </div>

    <!-- Edit Form -->
    <form id="form-edit-account" class="space-y-4">
      <input type="hidden" id="edit-account-id" />

      <!-- Display Name / Label -->
      <div>
        <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Account Persona / Label</label>
        <input
          type="text"
          id="edit-input-name"
          required
          class="w-full px-3 py-2 text-xs sm:text-sm bg-black border border-white/[0.1] rounded-xl text-white focus:outline-none focus:border-cyan-500 transition"
        />
      </div>

      <!-- Drop Claimed Status -->
      <div class="p-3.5 rounded-xl bg-black border border-white/[0.08]">
        <label class="flex items-center justify-between cursor-pointer">
          <div>
            <span class="block text-xs font-bold text-white">Drop Claimed This Reset</span>
            <span class="text-[11px] text-zinc-400">Did this account receive its Weekly Care Package?</span>
          </div>
          <input
            type="checkbox"
            id="edit-input-drop-claimed"
            class="w-5 h-5 accent-emerald-400 rounded cursor-pointer"
          />
        </label>

        <!-- Drop Item Details (visible if claimed) -->
        <div id="edit-drop-details" class="mt-3 pt-3 border-t border-white/[0.06] grid grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] text-zinc-400 mb-1">Dropped Item / Case</label>
            <input
              type="text"
              id="edit-input-item-name"
              placeholder="e.g. Kilowatt Case"
              class="w-full px-2.5 py-1.5 text-xs bg-zinc-900 border border-white/[0.1] rounded-lg text-white"
            />
          </div>
          <div>
            <label class="block text-[11px] text-zinc-400 mb-1">Est. Value ($ USD)</label>
            <input
              type="number"
              step="0.01"
              id="edit-input-item-price"
              placeholder="1.85"
              class="w-full px-2.5 py-1.5 text-xs bg-zinc-900 border border-white/[0.1] rounded-lg text-white"
            />
          </div>
        </div>
      </div>

      <!-- Rank & Current XP -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Profile Rank (1 - 40)</label>
          <input
            type="number"
            id="edit-input-rank"
            min="1"
            max="40"
            class="w-full px-3 py-2 text-xs sm:text-sm bg-black border border-white/[0.1] rounded-xl text-white focus:outline-none focus:border-cyan-500 transition"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Current XP in Rank (0 - 5000)</label>
          <input
            type="number"
            id="edit-input-xp"
            min="0"
            max="5000"
            step="10"
            class="w-full px-3 py-2 text-xs sm:text-sm bg-black border border-white/[0.1] rounded-xl text-white focus:outline-none focus:border-cyan-500 transition"
          />
        </div>
      </div>

      <!-- XP Multiplier Bracket -->
      <div>
        <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Weekly XP Multiplier Bracket</label>
        <select
          id="edit-input-multiplier"
          class="w-full px-3 py-2 text-xs sm:text-sm bg-black border border-white/[0.1] rounded-xl text-white focus:outline-none focus:border-cyan-500 transition"
        >
          <option value="overachieving">Overachieving (Bonus XP ~3x)</option>
          <option value="standard">Standard XP (1.0x)</option>
          <option value="reduced">Reduced XP (0.5x)</option>
          <option value="penalty">Diminished Penalty (0.175x)</option>
        </select>
      </div>

      <!-- Service Medal Tier -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Service Medal Year</label>
          <input
            type="number"
            id="edit-input-medal-year"
            value="2026"
            class="w-full px-3 py-2 text-xs sm:text-sm bg-black border border-white/[0.1] rounded-xl text-white focus:outline-none focus:border-cyan-500 transition"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Medal Tier (1 - 6)</label>
          <select
            id="edit-input-medal-tier"
            class="w-full px-3 py-2 text-xs sm:text-sm bg-black border border-white/[0.1] rounded-xl text-white focus:outline-none focus:border-cyan-500 transition"
          >
            <option value="1">Tier 1 - Silver / Grey</option>
            <option value="2">Tier 2 - Emerald Green</option>
            <option value="3">Tier 3 - Cyan / Blue</option>
            <option value="4">Tier 4 - Royal Purple</option>
            <option value="5">Tier 5 - Magenta Pink</option>
            <option value="6">Tier 6 - Ruby Red</option>
          </select>
        </div>
      </div>

      <!-- Notes / Tags -->
      <div>
        <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Notes & Custom Tags (comma separated)</label>
        <input
          type="text"
          id="edit-input-tags"
          placeholder="Main, Premier 15k, Farm Bot 01"
          class="w-full px-3 py-2 text-xs sm:text-sm bg-black border border-white/[0.1] rounded-xl text-white focus:outline-none focus:border-cyan-500 transition"
        />
      </div>

      <!-- Actions -->
      <div class="pt-3 flex items-center justify-between gap-3">
        <button
          type="button"
          id="btn-delete-account-modal"
          class="px-4 py-2.5 text-xs font-semibold text-red-400 hover:text-red-300 hover:bg-red-950/30 rounded-xl transition border border-red-500/20 cursor-pointer"
        >
          Remove Account
        </button>
        <button
          type="submit"
          class="px-6 py-2.5 text-xs sm:text-sm font-semibold text-black bg-cyan-400 hover:bg-cyan-300 rounded-xl transition glow-cyan cursor-pointer"
        >
          Save Changes
        </button>
      </div>
    </form>
  </div>
</div>
