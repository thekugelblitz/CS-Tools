---
import Icons from './Icons.astro';
---

<section id="lootflow-tracker-root" class="space-y-6 sm:space-y-8">
  <!-- Top Hero Header with LootFlow Branding & Quick Actions -->
  <div class="p-4 sm:p-6 rounded-2xl sm:rounded-3xl bg-[#11161d] border border-white/[0.08] shadow-2xl backdrop-blur-xl space-y-5">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <!-- Title & Branding -->
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[11px] font-bold uppercase tracking-wider mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>LootFlow 2.0 Engine</span>
          <span class="text-zinc-500">·</span>
          <span class="text-zinc-300">CS2 Prime Drop & ROI Analytics</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-2.5">
          <span>Weekly Drops, Fleet & Farm ROI</span>
        </h2>
        <p class="text-xs sm:text-sm text-zinc-400 mt-1 max-w-2xl">
          Automated CS2 Prime weekly drop limits, Steam Market cached valuations, payback vs Prime investment, and discovered collection tracking.
        </p>
      </div>

      <!-- Currency Switcher & Drop Reset Timer -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
        <!-- Live Reset Pill -->
        <div class="px-3 py-1.5 rounded-xl bg-[#0d1117] border border-white/[0.08] flex items-center gap-2 text-xs">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span class="text-zinc-400 font-medium">Reset:</span>
          <span id="lf-reset-countdown" class="font-mono font-bold text-amber-400">Loading...</span>
        </div>

        <!-- Currency Selector -->
        <div class="flex items-center bg-[#0d1117] border border-white/[0.08] rounded-xl p-1 gap-1">
          <button class="lf-currency-btn px-2.5 py-1 rounded-lg text-xs font-mono font-bold transition cursor-pointer bg-emerald-500/20 text-emerald-400" data-curr="USD">$ USD</button>
          <button class="lf-currency-btn px-2.5 py-1 rounded-lg text-xs font-mono font-bold transition cursor-pointer text-zinc-400 hover:text-white" data-curr="BRL">R$ BRL</button>
          <button class="lf-currency-btn px-2.5 py-1 rounded-lg text-xs font-mono font-bold transition cursor-pointer text-zinc-400 hover:text-white" data-curr="EUR">€ EUR</button>
          <button class="lf-currency-btn px-2.5 py-1 rounded-lg text-xs font-mono font-bold transition cursor-pointer text-zinc-400 hover:text-white" data-curr="INR">₹ INR</button>
          <button class="lf-currency-btn px-2.5 py-1 rounded-lg text-xs font-mono font-bold transition cursor-pointer text-zinc-400 hover:text-white" data-curr="GBP">£ GBP</button>
        </div>
      </div>
    </div>

    <!-- Quick Action Toolbars -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-white/[0.06]">
      <div class="flex flex-wrap items-center gap-2">
        <button
          id="btn-open-log-drop"
          class="px-4 py-2 rounded-xl bg-emerald-400 hover:bg-emerald-300 text-black font-extrabold text-xs sm:text-sm flex items-center gap-2 transition glow-emerald cursor-pointer"
        >
          <Icons name="plus" class="w-4 h-4 stroke-[3]" />
          <span>Log New Drop</span>
        </button>

        <button
          id="btn-open-add-account"
          class="px-3.5 py-2 rounded-xl bg-[#161b22] hover:bg-[#1c2128] text-white border border-white/[0.08] font-bold text-xs sm:text-sm flex items-center gap-2 transition cursor-pointer"
        >
          <Icons name="steam" class="w-4 h-4 text-emerald-400" />
          <span>Add Account</span>
        </button>

        <button
          id="btn-open-add-goal"
          class="px-3.5 py-2 rounded-xl bg-[#161b22] hover:bg-[#1c2128] text-zinc-300 hover:text-white border border-white/[0.08] font-semibold text-xs sm:text-sm flex items-center gap-2 transition cursor-pointer"
        >
          <Icons name="medal" class="w-4 h-4 text-amber-400" />
          <span>New Goal</span>
        </button>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="btn-open-data-modal"
          class="px-3 py-1.5 rounded-lg bg-[#0d1117] hover:bg-[#161b22] text-zinc-400 hover:text-zinc-200 border border-white/[0.06] text-xs font-mono transition flex items-center gap-1.5 cursor-pointer"
          title="Backup, Export & Demo Sync"
        >
          <Icons name="download" class="w-3.5 h-3.5" />
          <span>Export / Sync</span>
        </button>
        <button
          id="btn-quick-demo-reset"
          class="px-2.5 py-1.5 rounded-lg bg-[#0d1117] hover:bg-[#161b22] text-zinc-400 hover:text-amber-400 border border-white/[0.06] text-xs font-mono transition flex items-center gap-1 cursor-pointer"
          title="Reset to demo fleet"
        >
          <Icons name="refresh" class="w-3.5 h-3.5" />
          <span>Reset Demo</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Hero Financial ROI & Farm Metrics Grid -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
    <!-- Card 1: Gross Drop Revenue -->
    <div class="p-4 rounded-2xl bg-[#11161d] border border-white/[0.07] flex flex-col justify-between space-y-2 hover:border-emerald-500/30 transition">
      <div class="flex items-center justify-between text-xs">
        <span class="text-zinc-400 font-semibold">Total Drops Value</span>
        <span class="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-400">
          <Icons name="drop-box" class="w-3.5 h-3.5" />
        </span>
      </div>
      <div>
        <div id="stat-gross-value" class="text-xl sm:text-2xl font-black font-mono text-emerald-400">$0.00</div>
        <div id="stat-total-drops-sub" class="text-[11px] text-zinc-500 font-mono mt-0.5">0 drops recorded</div>
      </div>
      <div class="text-[10px] text-zinc-400 bg-white/[0.03] px-2 py-0.5 rounded flex items-center justify-between">
        <span>Avg: <strong id="stat-avg-drop" class="text-zinc-200 font-mono">$0.00</strong></span>
        <span>Best: <strong id="stat-best-drop" class="text-amber-400 font-mono">$0.00</strong></span>
      </div>
    </div>

    <!-- Card 2: Realized Cashout -->
    <div class="p-4 rounded-2xl bg-[#11161d] border border-white/[0.07] flex flex-col justify-between space-y-2 hover:border-cyan-500/30 transition">
      <div class="flex items-center justify-between text-xs">
        <span class="text-zinc-400 font-semibold">Realized Cashout</span>
        <span class="p-1.5 rounded-lg bg-cyan-500/10 text-cyan-400">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path><path d="M12 18V6"></path></svg>
        </span>
      </div>
      <div>
        <div id="stat-cashout-value" class="text-xl sm:text-2xl font-black font-mono text-cyan-400">$0.00</div>
        <div id="stat-sold-count-sub" class="text-[11px] text-zinc-500 font-mono mt-0.5">0 items sold</div>
      </div>
      <div class="text-[10px] text-zinc-400 bg-white/[0.03] px-2 py-0.5 rounded">
        <span>Liquid Market & 3rd-Party Balance</span>
      </div>
    </div>

    <!-- Card 3: Prime Fleet Cost -->
    <div class="p-4 rounded-2xl bg-[#11161d] border border-white/[0.07] flex flex-col justify-between space-y-2 hover:border-purple-500/30 transition">
      <div class="flex items-center justify-between text-xs">
        <span class="text-zinc-400 font-semibold">Prime Investment</span>
        <span class="p-1.5 rounded-lg bg-purple-500/10 text-purple-400">
          <Icons name="shield-check" class="w-3.5 h-3.5" />
        </span>
      </div>
      <div>
        <div id="stat-prime-cost" class="text-xl sm:text-2xl font-black font-mono text-purple-300">$0.00</div>
        <div id="stat-accounts-sub" class="text-[11px] text-zinc-500 font-mono mt-0.5">0 active accounts</div>
      </div>
      <div class="text-[10px] text-zinc-400 bg-white/[0.03] px-2 py-0.5 rounded">
        <span>Fixed Status Acquisition</span>
      </div>
    </div>

    <!-- Card 4: Net Balance & ROI -->
    <div class="p-4 rounded-2xl bg-[#11161d] border border-white/[0.07] flex flex-col justify-between space-y-2 hover:border-emerald-500/30 transition">
      <div class="flex items-center justify-between text-xs">
        <span class="text-zinc-400 font-semibold">Farm ROI & Net</span>
        <span id="stat-roi-badge" class="px-1.5 py-0.5 rounded text-[10px] font-mono font-black uppercase bg-emerald-500/20 text-emerald-400">
          +0%
        </span>
      </div>
      <div>
        <div id="stat-net-profit" class="text-xl sm:text-2xl font-black font-mono text-white">$0.00</div>
        <div id="stat-roi-sub" class="text-[11px] text-zinc-500 font-mono mt-0.5">Payback in progress</div>
      </div>
      <div class="text-[10px] text-zinc-400 bg-white/[0.03] px-2 py-0.5 rounded">
        <span>Prime Cost Recovery Balance</span>
      </div>
    </div>

    <!-- Card 5: Weekly Drop Claims & Streak -->
    <div class="p-4 rounded-2xl bg-[#11161d] border border-white/[0.07] flex flex-col justify-between space-y-2 col-span-2 sm:col-span-1 hover:border-amber-500/30 transition">
      <div class="flex items-center justify-between text-xs">
        <span class="text-zinc-400 font-semibold">Current Week Drops</span>
        <span id="stat-streak-badge" class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/20 text-amber-400 flex items-center gap-1">
          <span>🔥</span> <span id="stat-streak-count">0</span>
        </span>
      </div>
      <div>
        <div id="stat-week-claims" class="text-xl sm:text-2xl font-black font-mono text-amber-400">0 / 0</div>
        <div id="stat-week-status-sub" class="text-[11px] text-zinc-500 font-mono mt-0.5">Tuesday Reset Cycle</div>
      </div>
      <div class="text-[10px] text-zinc-400 bg-white/[0.03] px-2 py-0.5 rounded">
        <span>Max 2 drops / account / week</span>
      </div>
    </div>
  </div>

  <!-- Prime Break-Even Payback Progress Meter -->
  <div class="p-4 sm:p-5 rounded-2xl bg-[#11161d] border border-white/[0.07] space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
      <div class="flex items-center gap-2">
        <span class="font-extrabold text-white text-sm">Prime Cost Payback Progress</span>
        <span id="pb-progress-badge" class="px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono font-bold text-[11px]">
          0% Payback
        </span>
      </div>
      <div class="flex items-center gap-3 text-zinc-400 text-[11px]">
        <span>Remaining to break-even: <strong id="pb-remaining-amount" class="text-white font-mono">$0.00</strong></span>
        <span>·</span>
        <span id="pb-eta-text" class="text-amber-400 font-medium">ETA: ~0 weeks</span>
      </div>
    </div>

    <!-- Dual Progress Bar -->
    <div class="relative w-full h-3 rounded-full bg-[#0d1117] border border-white/[0.06] overflow-hidden">
      <div
        id="pb-progress-bar"
        class="h-full bg-gradient-to-r from-cyan-500 via-emerald-400 to-amber-400 rounded-full transition-all duration-700 glow-emerald"
        style="width: 0%"
      ></div>
    </div>
  </div>

  <!-- Internal Navigation Sub-Tabs -->
  <div class="border-b border-white/[0.08] flex items-center gap-2 overflow-x-auto pb-1 text-xs sm:text-sm font-semibold">
    <button
      class="lf-tab-btn px-4 py-2 rounded-xl text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 transition flex items-center gap-2 cursor-pointer shrink-0"
      data-tab="fleet"
    >
      <Icons name="steam" class="w-4 h-4" />
      <span>Account Fleet (<span id="count-tab-fleet">0</span>)</span>
    </button>

    <button
      class="lf-tab-btn px-4 py-2 rounded-xl text-zinc-400 hover:text-white hover:bg-white/[0.03] transition flex items-center gap-2 cursor-pointer shrink-0"
      data-tab="ledger"
    >
      <Icons name="drop-box" class="w-4 h-4" />
      <span>Drop Ledger (<span id="count-tab-drops">0</span>)</span>
    </button>

    <button
      class="lf-tab-btn px-4 py-2 rounded-xl text-zinc-400 hover:text-white hover:bg-white/[0.03] transition flex items-center gap-2 cursor-pointer shrink-0"
      data-tab="collection"
    >
      <Icons name="medal" class="w-4 h-4" />
      <span>Discovered Codex (<span id="count-tab-collection">0</span>)</span>
    </button>

    <button
      class="lf-tab-btn px-4 py-2 rounded-xl text-zinc-400 hover:text-white hover:bg-white/[0.03] transition flex items-center gap-2 cursor-pointer shrink-0"
      data-tab="goals"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
      <span>Goals & Streaks (<span id="count-tab-goals">0</span>)</span>
    </button>

    <button
      class="lf-tab-btn px-4 py-2 rounded-xl text-zinc-400 hover:text-white hover:bg-white/[0.03] transition flex items-center gap-2 cursor-pointer shrink-0"
      data-tab="xp-radar"
    >
      <Icons name="xp" class="w-4 h-4 text-cyan-400" />
      <span>XP & Service Medal</span>
    </button>
  </div>

  <!-- Tab 1: Account Fleet Grid -->
  <div id="tab-content-fleet" class="space-y-4">
    <div id="fleet-accounts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Dynamically rendered via JS -->
    </div>
  </div>

  <!-- Tab 2: Drop Ledger & History Table -->
  <div id="tab-content-ledger" class="space-y-4 hidden">
    <!-- Filter & Search Controls -->
    <div class="p-3.5 rounded-2xl bg-[#11161d] border border-white/[0.07] flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 text-xs">
      <div class="flex flex-wrap items-center gap-2">
        <input
          id="input-filter-drop-name"
          type="text"
          placeholder="Filter by item or account..."
          class="px-3 py-2 rounded-xl bg-[#0d1117] border border-white/[0.08] focus:border-emerald-500/50 text-white placeholder:text-zinc-500 font-mono outline-none text-xs w-full sm:w-64"
        />

        <select
          id="select-filter-type"
          class="px-3 py-2 rounded-xl bg-[#0d1117] border border-white/[0.08] text-zinc-300 font-mono outline-none text-xs cursor-pointer"
        >
          <option value="all">All Types</option>
          <option value="case">Cases Only</option>
          <option value="weapon">Weapon Skins</option>
          <option value="graffiti">Graffitis</option>
          <option value="sticker">Stickers</option>
        </select>

        <select
          id="select-filter-sold"
          class="px-3 py-2 rounded-xl bg-[#0d1117] border border-white/[0.08] text-zinc-300 font-mono outline-none text-xs cursor-pointer"
        >
          <option value="all">All Statuses</option>
          <option value="sold">Sold Items</option>
          <option value="unsold">In Inventory</option>
        </select>
      </div>

      <div class="flex items-center gap-2 justify-end">
        <button
          id="btn-export-csv"
          class="px-3 py-2 rounded-xl bg-[#161b22] hover:bg-[#1c2128] text-zinc-300 hover:text-white border border-white/[0.08] transition flex items-center gap-1.5 cursor-pointer"
        >
          <Icons name="download" class="w-3.5 h-3.5" />
          <span>Export CSV</span>
        </button>
      </div>
    </div>

    <!-- Table Container -->
    <div class="overflow-x-auto rounded-2xl bg-[#11161d] border border-white/[0.07] shadow-xl">
      <table class="w-full text-left text-xs sm:text-sm">
        <thead class="bg-[#0d1117] text-zinc-400 uppercase font-mono text-[10px] sm:text-[11px] border-b border-white/[0.06]">
          <tr>
            <th class="py-3.5 px-4 font-semibold">Item & Details</th>
            <th class="py-3.5 px-4 font-semibold">Account</th>
            <th class="py-3.5 px-4 font-semibold">Week Cycle</th>
            <th class="py-3.5 px-4 font-semibold">Steam Est.</th>
            <th class="py-3.5 px-4 font-semibold">Status / Cashout</th>
            <th class="py-3.5 px-4 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="drops-table-body" class="divide-y divide-white/[0.04] font-mono">
          <!-- Populated dynamically via JS -->
        </tbody>
      </table>
    </div>
  </div>

  <!-- Tab 3: Discovered Collection Codex -->
  <div id="tab-content-collection" class="space-y-4 hidden">
    <div class="p-4 rounded-2xl bg-[#11161d] border border-white/[0.07] flex items-center justify-between">
      <div>
        <h3 class="text-sm sm:text-base font-extrabold text-white">Discovered Drop Codex</h3>
        <p class="text-xs text-zinc-400">All unique CS2 items discovered and logged across your farming fleet.</p>
      </div>
      <div class="px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono font-bold">
        <span id="collection-unlocked-count">0</span> Unique Drops
      </div>
    </div>

    <div id="collection-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4">
      <!-- Populated dynamically via JS -->
    </div>
  </div>

  <!-- Tab 4: Goals & Streaks -->
  <div id="tab-content-goals" class="space-y-4 hidden">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Perfect Weeks & Streaks Card -->
      <div class="p-5 rounded-2xl bg-[#11161d] border border-white/[0.07] space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xl">🔥</span>
            <h3 class="font-extrabold text-white text-sm sm:text-base">Perfect Week Streaks</h3>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-amber-500/10 text-amber-400 border border-amber-500/20">
            Efficiency
          </span>
        </div>
        <p class="text-xs text-zinc-400 leading-relaxed">
          A <strong>Perfect Week</strong> is achieved when every active Prime account in your fleet completes its 2 weekly care package drops before Tuesday 8PM CT reset.
        </p>

        <div class="grid grid-cols-2 gap-3 pt-2">
          <div class="p-3.5 rounded-xl bg-[#0d1117] border border-white/[0.06] text-center">
            <div class="text-xs text-zinc-400 font-semibold mb-1">Current Streak</div>
            <div id="goal-current-streak" class="text-2xl font-black font-mono text-amber-400">0 Weeks</div>
          </div>
          <div class="p-3.5 rounded-xl bg-[#0d1117] border border-white/[0.06] text-center">
            <div class="text-xs text-zinc-400 font-semibold mb-1">All-Time Best</div>
            <div id="goal-best-streak" class="text-2xl font-black font-mono text-emerald-400">0 Weeks</div>
          </div>
        </div>
      </div>

      <!-- Farm System Insights -->
      <div class="p-5 rounded-2xl bg-[#11161d] border border-white/[0.07] space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-xl">💡</span>
            <h3 class="font-extrabold text-white text-sm sm:text-base">Smart Farm Insights</h3>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
            AI Telemetry
          </span>
        </div>

        <div id="goals-insights-list" class="space-y-2.5 text-xs text-zinc-300">
          <!-- Injected dynamically -->
        </div>
      </div>
    </div>

    <!-- Active Farm Goals List -->
    <div class="p-5 rounded-2xl bg-[#11161d] border border-white/[0.07] space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="font-extrabold text-white text-sm sm:text-base">Active Targets & Milestone Goals</h3>
        <button
          id="btn-goals-add-trigger"
          class="px-3 py-1.5 rounded-xl bg-emerald-400 text-black font-bold text-xs flex items-center gap-1.5 transition glow-emerald cursor-pointer"
        >
          <Icons name="plus" class="w-3.5 h-3.5 stroke-[3]" />
          <span>New Target Goal</span>
        </button>
      </div>

      <div id="goals-list-container" class="space-y-3">
        <!-- Injected dynamically -->
      </div>
    </div>
  </div>

  <!-- Tab 5: XP & Service Medal Progression Radar (Zero-Dependency CS2 XP Tracker) -->
  <div id="tab-content-xp-radar" class="space-y-6 hidden">
    <!-- Header with Account Picker & Multiplier info -->
    <div class="p-5 rounded-3xl bg-[#11161d] border border-white/[0.08] flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-[11px] font-bold uppercase tracking-wider mb-2">
          <span>🎖️ Profile Rank, XP & 2026 Service Medal Radar</span>
          <span class="text-zinc-500">·</span>
          <span class="text-zinc-300">Zero-Bot Dependency</span>
        </div>
        <h3 class="text-xl sm:text-2xl font-black text-white">CS2 Profile XP & Service Medal Tracker</h3>
        <p class="text-xs text-zinc-400 mt-1 max-w-2xl">
          Tracks the 5,000 XP profile rank-up required for weekly care packages, calculates weekly multiplier brackets, and projects matches needed for Rank 40 Service Medals.
        </p>
      </div>

      <div class="flex items-center gap-2.5 w-full md:w-auto">
        <label class="text-xs font-semibold text-zinc-400 whitespace-nowrap">Account:</label>
        <select
          id="select-xp-account"
          class="px-3.5 py-2 rounded-xl bg-[#0d1117] border border-white/[0.1] text-white text-xs sm:text-sm font-mono outline-none focus:border-cyan-500/50 w-full md:w-56 cursor-pointer"
        >
          <!-- Dynamically populated with fleet accounts -->
        </select>
      </div>
    </div>

    <!-- Active Account XP & Rank Telemetry Card -->
