        />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Target Amount (USD) *</label>
          <input
            id="goal-input-amount"
            type="number"
            step="0.01"
            required
            placeholder="100.00"
            class="w-full px-3.5 py-2.5 rounded-xl bg-[#0d1117] border border-white/[0.1] text-white text-xs sm:text-sm font-mono outline-none focus:border-emerald-500/50"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Goal Type</label>
          <select
            id="goal-input-type"
            class="w-full px-3.5 py-2.5 rounded-xl bg-[#0d1117] border border-white/[0.1] text-white text-xs sm:text-sm font-mono outline-none focus:border-emerald-500/50"
          >
            <option value="revenue">Total Drop Revenue</option>
            <option value="cashout">Realized Cashout</option>
            <option value="profit">Net Profit Over Cost</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Target CS2 Item (Optional)</label>
        <input
          id="goal-input-item-name"
          type="text"
          placeholder="e.g. AWP | Asiimov (Field-Tested)"
          class="w-full px-3.5 py-2.5 rounded-xl bg-[#0d1117] border border-white/[0.1] text-white text-xs sm:text-sm font-mono outline-none focus:border-emerald-500/50"
        />
      </div>

      <!-- Submit Buttons -->
      <div class="flex items-center justify-end gap-2.5 pt-2">
        <button
          type="button"
          class="btn-close-modal px-4 py-2.5 rounded-xl bg-[#161b22] hover:bg-[#1c2128] text-zinc-300 text-xs font-bold cursor-pointer transition"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-black font-extrabold text-xs sm:text-sm glow-gold cursor-pointer transition"
        >
          Create Goal
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 4. Export / Import Data Sync Modal -->
<div id="modal-data-sync" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
  <div class="relative w-full max-w-md rounded-3xl bg-[#11161d] border border-white/[0.12] shadow-2xl p-5 sm:p-6 space-y-5">
    <div class="flex items-center justify-between pb-3 border-b border-white/[0.08]">
      <div class="flex items-center gap-2.5">
        <div class="p-2 rounded-xl bg-purple-500/10 text-purple-400">
          <Icons name="download" class="w-5 h-5" />
        </div>
        <div>
          <h3 class="text-lg font-black text-white">Data Backup & Export</h3>
          <p class="text-xs text-zinc-400">Export drops to CSV, backup JSON, or restore.</p>
        </div>
      </div>
      <button class="btn-close-modal text-zinc-400 hover:text-white p-1 cursor-pointer">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="space-y-3 text-xs">
      <button
        id="btn-sync-export-csv"
        class="w-full p-3.5 rounded-xl bg-[#0d1117] hover:bg-[#161b22] border border-white/[0.08] flex items-center justify-between transition cursor-pointer text-left group"
      >
        <div>
          <div class="font-bold text-white group-hover:text-emerald-400 transition">Download Drops Ledger (.CSV)</div>
          <div class="text-zinc-500 text-[11px]">Spreadsheet format compatible with Excel and Google Sheets</div>
        </div>
        <Icons name="download" class="w-4 h-4 text-zinc-400 group-hover:text-emerald-400" />
      </button>

      <button
        id="btn-sync-export-json"
        class="w-full p-3.5 rounded-xl bg-[#0d1117] hover:bg-[#161b22] border border-white/[0.08] flex items-center justify-between transition cursor-pointer text-left group"
      >
        <div>
          <div class="font-bold text-white group-hover:text-cyan-400 transition">Download Complete Backup (.JSON)</div>
          <div class="text-zinc-500 text-[11px]">Full backup of accounts, drops, goals, and history</div>
        </div>
        <Icons name="download" class="w-4 h-4 text-zinc-400 group-hover:text-cyan-400" />
      </button>

      <div class="p-3.5 rounded-xl bg-[#0d1117] border border-white/[0.08] space-y-2">
        <div class="font-bold text-white">Restore / Import Backup (.JSON)</div>
        <input
          type="file"
          id="input-import-json-file"
          accept=".json"
          class="w-full text-xs text-zinc-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#1c2128] file:text-zinc-200 hover:file:bg-[#252b35] cursor-pointer"
        />
      </div>

      <div class="pt-2 flex items-center justify-between border-t border-white/[0.06]">
        <button
          id="btn-danger-clear-all"
          class="px-3 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 text-[11px] font-bold transition cursor-pointer"
        >
          Clear All Data
        </button>

        <button
          type="button"
          class="btn-close-modal px-4 py-1.5 rounded-xl bg-[#161b22] text-zinc-300 text-xs font-semibold cursor-pointer"
        >
          Done
        </button>
      </div>
    </div>
  </div>
</div>
