---
import Icons from './Icons.astro';
---

<div
  id="modal-add-account"
  class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-black/80 backdrop-blur-md transition-opacity"
>
  <div class="relative w-full max-w-lg rounded-2xl bg-surface-1 border border-white/[0.12] shadow-2xl p-6 sm:p-7 overflow-hidden">
    <!-- Close button -->
    <button
      id="btn-close-add-modal"
      class="absolute top-5 right-5 p-1.5 text-zinc-400 hover:text-white rounded-lg hover:bg-zinc-800 transition"
    >
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="6"></line>
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="flex items-center gap-3 mb-5">
      <div class="p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
        <Icons name="plus" class="w-5 h-5 stroke-[2.5]" />
      </div>
      <div>
        <h3 class="text-lg font-bold text-white">Add Steam Account</h3>
        <p class="text-xs text-zinc-400">Track drops, weekly XP, and service medals</p>
      </div>
    </div>

    <!-- Mode Tabs: Single vs Bulk -->
    <div class="flex border-b border-white/[0.08] mb-5">
      <button
        id="tab-single-add"
        class="tab-btn pb-2.5 px-4 text-xs font-semibold text-emerald-400 border-b-2 border-emerald-400 transition"
      >
        Single Account
      </button>
      <button
        id="tab-bulk-add"
        class="tab-btn pb-2.5 px-4 text-xs font-semibold text-zinc-400 hover:text-white border-b-2 border-transparent transition"
      >
        Bulk Import (Multiple)
      </button>
    </div>

    <!-- Single Account Form -->
    <form id="form-single-add" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-zinc-300 mb-1.5">
          Steam Profile URL, Vanity ID, or SteamID64 <span class="text-emerald-400">*</span>
        </label>
        <div class="relative">
          <input
            type="text"
            id="add-input-url"
            required
            placeholder="e.g. https://steamcommunity.com/id/s1mple or 76561198..."
            class="w-full pl-3.5 pr-20 py-2.5 text-xs sm:text-sm bg-black border border-white/[0.1] rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition"
          />
          <button
            type="button"
            id="btn-resolve-steam"
            class="absolute right-1.5 top-1.5 bottom-1.5 px-3 text-[11px] font-semibold text-black bg-emerald-400 hover:bg-emerald-300 rounded-lg transition flex items-center gap-1 cursor-pointer"
          >
            <span>Resolve</span>
          </button>
        </div>
        <p class="text-[11px] text-zinc-500 mt-1">Accepts any custom URL or numeric 64-bit Steam ID.</p>
      </div>

      <!-- Live Resolve Preview (Hidden until resolved) -->
      <div id="resolve-preview" class="hidden p-3 rounded-xl bg-black/60 border border-emerald-500/30 flex items-center gap-3">
        <img id="resolve-avatar" src="" alt="Avatar" class="w-10 h-10 rounded-lg border border-emerald-500/40 object-cover" />
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2">
            <span id="resolve-name" class="font-bold text-white text-xs truncate">Steam User</span>
            <span class="px-1.5 py-0.5 text-[9px] font-bold uppercase bg-emerald-950 text-emerald-400 border border-emerald-500/30 rounded">Verified</span>
          </div>
          <p id="resolve-id" class="text-[10px] text-zinc-400 font-mono truncate">7656119...</p>
        </div>
      </div>

      <!-- Account Custom Nickname / Tag -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Custom Label (Optional)</label>
          <input
            type="text"
            id="add-input-nickname"
            placeholder="e.g. Main / Smurf #1"
            class="w-full px-3 py-2 text-xs sm:text-sm bg-black border border-white/[0.1] rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Initial Rank (1-40)</label>
          <input
            type="number"
            id="add-input-rank"
            min="1"
            max="40"
            value="1"
            class="w-full px-3 py-2 text-xs sm:text-sm bg-black border border-white/[0.1] rounded-xl text-white focus:outline-none focus:border-emerald-500 transition"
          />
        </div>
      </div>

      <!-- Drop status radio -->
      <div>
        <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Initial Drop Status</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-black border border-emerald-500/30 text-xs text-zinc-200 cursor-pointer hover:bg-emerald-950/20">
            <input type="radio" name="add-drop-status" value="available" checked class="accent-emerald-400" />
            <span class="font-medium text-emerald-400">Drop Ready</span>
          </label>
          <label class="flex items-center gap-2 p-2.5 rounded-xl bg-black border border-white/[0.08] text-xs text-zinc-200 cursor-pointer hover:bg-yellow-950/20">
            <input type="radio" name="add-drop-status" value="claimed" class="accent-yellow-400" />
            <span class="font-medium text-yellow-400">Claimed This Week</span>
          </label>
        </div>
      </div>

      <!-- Submit button -->
      <div class="pt-2">
        <button
          type="submit"
          id="btn-submit-single-add"
          class="w-full py-2.5 text-xs sm:text-sm font-semibold text-black bg-emerald-400 hover:bg-emerald-300 rounded-xl transition glow-emerald cursor-pointer"
        >
          Add to Fleet
        </button>
      </div>
    </form>

    <!-- Bulk Accounts Form (Hidden by default) -->
    <form id="form-bulk-add" class="hidden space-y-4">
      <div>
        <label class="block text-xs font-semibold text-zinc-300 mb-1.5">
          Paste Steam URLs or SteamID64s (One per line)
        </label>
        <textarea
          id="bulk-input-text"
          rows="5"
          placeholder="https://steamcommunity.com/id/account1&#10;https://steamcommunity.com/profiles/76561198000000000&#10;s1mple"
          class="w-full p-3 font-mono text-xs bg-black border border-white/[0.1] rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:border-emerald-500 transition"
        ></textarea>
        <p class="text-[11px] text-zinc-500 mt-1">Each row will be converted into a tracked fleet account.</p>
      </div>

      <div class="pt-2">
        <button
          type="submit"
          class="w-full py-2.5 text-xs sm:text-sm font-semibold text-black bg-emerald-400 hover:bg-emerald-300 rounded-xl transition glow-emerald cursor-pointer"
        >
          Import Accounts
        </button>
      </div>
    </form>
  </div>
</div>
