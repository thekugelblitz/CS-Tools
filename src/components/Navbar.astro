---
import Icons from './Icons.astro';
---

<header class="sticky top-0 z-40 border-b border-white/[0.08] bg-black/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
    <!-- Brand Logo -->
    <div class="flex items-center gap-3">
      <div class="relative flex items-center justify-center w-10 h-10 rounded-xl bg-surface-1 border border-emerald-500/30 text-emerald-400 glow-emerald">
        <Icons name="drop-box" class="w-5 h-5 text-emerald-400 animate-pulse" />
        <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-black"></span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="font-extrabold tracking-wider text-white text-lg sm:text-xl">
            DROP<span class="text-emerald-400">RADAR</span>
          </span>
          <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-widest bg-emerald-950/60 text-emerald-400 border border-emerald-500/30 rounded-full">
            CS2 Prime
          </span>
        </div>
        <p class="text-xs text-zinc-400 hidden sm:block">Multi-Account Drop, XP & Medal Tracker</p>
      </div>
    </div>

    <!-- Center Navigation Tabs -->
    <nav class="hidden md:flex items-center gap-1 bg-zinc-950 p-1 rounded-xl border border-white/[0.08]">
      <button
        id="tab-nav-fleet"
        class="nav-tab active px-3.5 py-1.5 rounded-lg text-xs font-bold text-white bg-zinc-800 transition cursor-pointer"
        data-target="section-fleet"
      >
        📡 Fleet Radar
      </button>
      <button
        id="tab-nav-matches"
        class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-bold text-zinc-400 hover:text-white transition cursor-pointer"
        data-target="section-live-matches"
      >
        ⚔️ Live Matches
      </button>
      <button
        id="tab-nav-leaderboard"
        class="nav-tab px-3.5 py-1.5 rounded-lg text-xs font-bold text-zinc-400 hover:text-white transition cursor-pointer"
        data-target="section-pro-leaderboard"
      >
        🏆 Pro Rankings
      </button>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Log Match Button -->
      <button
        id="btn-open-log-match"
        title="Log a competitive match"
        class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-bold text-zinc-300 hover:text-white bg-zinc-900 hover:bg-zinc-800 border border-white/[0.08] hover:border-emerald-500/40 rounded-xl transition cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        <span class="hidden sm:inline">Log Match</span>
      </button>

      <!-- Settings Button -->
      <button
        id="btn-open-settings"
        title="Settings & Backup"
        class="p-2 text-zinc-400 hover:text-white bg-zinc-900/80 hover:bg-zinc-800 border border-white/[0.08] rounded-xl transition cursor-pointer"
      >
        <Icons name="settings" class="w-4 h-4" />
      </button>

      <!-- Add Account Button -->
      <button
        id="btn-open-add-modal"
        class="inline-flex items-center gap-2 px-3.5 py-2 text-xs sm:text-sm font-semibold text-black bg-emerald-400 hover:bg-emerald-300 rounded-xl transition glow-emerald cursor-pointer"
      >
        <Icons name="plus" class="w-4 h-4 text-black stroke-[3]" />
        <span>Add Account</span>
      </button>
    </div>
  </div>

  <!-- Mobile Tab Bar -->
  <div class="md:hidden flex items-center justify-around border-t border-white/[0.06] bg-black px-2 py-1.5">
    <button class="nav-tab active text-xs font-bold text-white px-2 py-1" data-target="section-fleet">📡 Fleet</button>
    <button class="nav-tab text-xs font-bold text-zinc-400 px-2 py-1" data-target="section-live-matches">⚔️ Matches</button>
    <button class="nav-tab text-xs font-bold text-zinc-400 px-2 py-1" data-target="section-pro-leaderboard">🏆 Rankings</button>
  </div>
</header>
