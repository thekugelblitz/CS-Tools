---
import Icons from './Icons.astro';
---

<header class="sticky top-0 z-40 border-b border-white/[0.08] bg-black/85 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-18 flex items-center justify-between gap-3">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
      <div class="relative flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-zinc-950 border border-emerald-500/30 group-hover:border-emerald-400/60 text-emerald-400 glow-emerald transition">
        <img src="/logo-icon.svg" alt="CS2Live" class="w-5 h-5 sm:w-6 sm:h-6" />
        <span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-emerald-400 ring-2 ring-black animate-pulse"></span>
      </div>
      <div>
        <div class="flex items-center gap-1.5 sm:gap-2">
          <span class="font-extrabold tracking-wider text-white text-base sm:text-xl">
            CS2<span class="text-emerald-400">LIVE</span>
          </span>
          <span class="px-1.5 py-0.5 text-[9px] sm:text-[10px] font-bold uppercase tracking-widest bg-emerald-950/60 text-emerald-400 border border-emerald-500/30 rounded-full">
            RADAR
          </span>
        </div>
        <p class="text-[11px] text-zinc-400 hidden md:block">Stats, Cheater Detector & Drops</p>
      </div>
    </a>

    <!-- Center Navigation Links -->
    <nav class="hidden md:flex items-center gap-2">
      <a
        href="/"
        class="px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-zinc-800 hover:bg-zinc-700 transition"
      >
        Quick Look
      </a>
      <a
        href="/compare"
        class="px-3 py-1.5 rounded-lg text-xs font-bold text-zinc-400 hover:text-white hover:bg-zinc-900 transition"
      >
        Compare
      </a>
      <a
        href="/brand"
        class="px-3 py-1.5 rounded-lg text-xs font-bold text-zinc-400 hover:text-white hover:bg-zinc-900 transition"
      >
        Brandkit
      </a>
      <a
        href="/api/cs2/scavenger"
        target="_blank"
        class="px-3 py-1.5 rounded-lg text-xs font-bold text-zinc-400 hover:text-emerald-400 hover:bg-zinc-900 transition"
      >
        Live API
      </a>
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-2">
      <!-- User Auth Profile & Sign In Container -->
      <div id="nav-auth-container" class="flex items-center">
        <!-- Unauthenticated Button (Shown when logged out) -->
        <button
          id="btn-nav-open-auth"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-emerald-400 text-black text-xs font-extrabold transition cursor-pointer glow-emerald hover:bg-emerald-300"
        >
          <Icons name="user" class="w-3.5 h-3.5 text-black stroke-[3]" />
          <span>Sign In to Track</span>
        </button>

        <!-- Authenticated Profile Pill (Hidden by default, shown when logged in) -->
        <div id="nav-user-profile" class="hidden items-center gap-2">
          <button
            id="btn-nav-user-menu"
            class="flex items-center gap-2 px-2.5 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/[0.08] hover:border-emerald-500/30 transition cursor-pointer"
            title="User Account & Tracked Profiles"
          >
            <img
              id="nav-user-avatar"
              src="https://avatars.steamstatic.com/fef49e7fa7e1997310d705b2a6158ff8dc1cdfeb_full.jpg"
              alt="User Avatar"
              class="w-6 h-6 rounded-lg object-cover border border-emerald-500/40"
            />
            <span id="nav-user-name" class="text-xs font-bold text-white max-w-[100px] truncate hidden sm:inline">My Account</span>
            <span id="nav-user-tracked-count" class="px-1.5 py-0.5 rounded text-[9px] font-black uppercase tracking-wider bg-emerald-950 text-emerald-400 border border-emerald-500/30">
              0 Saved
            </span>
          </button>
        </div>
      </div>

      <!-- Settings Button -->
      <button
        id="btn-open-settings"
        title="Settings & Reset"
        class="p-2 sm:p-2.5 text-zinc-400 hover:text-white bg-zinc-900/80 hover:bg-zinc-800 border border-white/[0.08] rounded-xl transition cursor-pointer"
      >
        <Icons name="settings" class="w-4 h-4" />
      </button>
    </div>
  </div>
</header>
