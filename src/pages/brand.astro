---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Icons from '../components/Icons.astro';
---

<Layout
  title="Brand Identity & Assets | CS2Live — Minimalist Design System"
  description="Official CS2Live brand guidelines, minimalist vector logo assets, AMOLED color palette, typography specifications, and usage rules."
  canonical="https://cs2live.top/brand"
>
  <Navbar />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Header Hero -->
    <div class="border-b border-white/[0.08] pb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-4">
        <span>CS2Live Brandkit</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Brand Identity & Design System
      </h1>
      <p class="mt-2 text-sm sm:text-base text-zinc-400 max-w-2xl leading-relaxed">
        Our identity is rooted in precision, clarity, and stealth tactical utility. No gaudy 3D graphics or cluttered gimmicks—just pure, high-contrast AMOLED intelligence.
      </p>
    </div>

    <!-- Section 1: Logo Showcase & Downloads -->
    <section class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-white flex items-center gap-2">
            <span>Subtle Vector Logos</span>
          </h2>
          <p class="text-xs text-zinc-400">Scalable SVG assets optimized for dark backgrounds and esports displays.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Full Horizontal Logo -->
        <div class="p-6 rounded-2xl bg-zinc-950 border border-white/[0.08] flex flex-col justify-between space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-bold text-zinc-400 uppercase tracking-wider">Primary Wordmark Lockup</span>
            <div class="p-8 rounded-xl bg-black border border-white/[0.05] flex items-center justify-center min-h-[140px]">
              <img src="/logo.svg" alt="CS2Live Logo Full" class="h-10 w-auto" />
            </div>
          </div>
          <div class="flex items-center justify-between pt-2 border-t border-white/[0.06]">
            <span class="text-xs font-mono text-zinc-500">public/logo.svg</span>
            <a
              href="/logo.svg"
              download="cs2live-logo.svg"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-white/[0.1] text-xs font-bold text-white transition"
            >
              <span>Download SVG</span>
            </a>
          </div>
        </div>

        <!-- Standalone Minimalist Icon -->
        <div class="p-6 rounded-2xl bg-zinc-950 border border-white/[0.08] flex flex-col justify-between space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-bold text-zinc-400 uppercase tracking-wider">Radar Scope Icon</span>
            <div class="p-8 rounded-xl bg-black border border-white/[0.05] flex items-center justify-center min-h-[140px]">
              <img src="/logo-icon.svg" alt="CS2Live Icon" class="w-16 h-16" />
            </div>
          </div>
          <div class="flex items-center justify-between pt-2 border-t border-white/[0.06]">
            <span class="text-xs font-mono text-zinc-500">public/logo-icon.svg</span>
            <a
              href="/logo-icon.svg"
              download="cs2live-icon.svg"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-white/[0.1] text-xs font-bold text-white transition"
            >
              <span>Download SVG</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Color Tokens -->
    <section class="space-y-6">
      <div>
        <h2 class="text-xl font-bold text-white">Color Palette & Tokens</h2>
        <p class="text-xs text-zinc-400">Engineered for OLED and AMOLED displays to maximize contrast and focus on live telemetry.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        <!-- Tactical Emerald -->
        <div class="p-4 rounded-xl bg-zinc-950 border border-white/[0.08] space-y-3">
          <div class="w-full h-16 rounded-lg bg-[#10b981] shadow-lg shadow-emerald-500/20"></div>
          <div>
            <div class="text-xs font-bold text-white">Tactical Emerald</div>
            <div class="text-[11px] font-mono text-zinc-400">#10b981</div>
            <div class="text-[10px] text-zinc-500 mt-1">Live signal / Prime verified</div>
          </div>
        </div>

        <!-- Cyan Signal -->
        <div class="p-4 rounded-xl bg-zinc-950 border border-white/[0.08] space-y-3">
          <div class="w-full h-16 rounded-lg bg-[#06b6d4] shadow-lg shadow-cyan-500/20"></div>
          <div>
            <div class="text-xs font-bold text-white">Cyan Signal</div>
            <div class="text-[11px] font-mono text-zinc-400">#06b6d4</div>
            <div class="text-[10px] text-zinc-500 mt-1">XP telemetry & pings</div>
          </div>
        </div>

        <!-- Crimson Threat -->
        <div class="p-4 rounded-xl bg-zinc-950 border border-white/[0.08] space-y-3">
          <div class="w-full h-16 rounded-lg bg-[#ef4444] shadow-lg shadow-red-500/20"></div>
          <div>
            <div class="text-xs font-bold text-white">Crimson Threat</div>
            <div class="text-[11px] font-mono text-zinc-400">#ef4444</div>
            <div class="text-[10px] text-zinc-500 mt-1">Hacker / Cheater flags</div>
          </div>
        </div>

        <!-- Carbon Obsidian -->
        <div class="p-4 rounded-xl bg-zinc-950 border border-white/[0.08] space-y-3">
          <div class="w-full h-16 rounded-lg bg-[#09090b] border border-white/10"></div>
          <div>
            <div class="text-xs font-bold text-white">Carbon Obsidian</div>
            <div class="text-[11px] font-mono text-zinc-400">#09090b</div>
            <div class="text-[10px] text-zinc-500 mt-1">Primary card surfaces</div>
          </div>
        </div>

        <!-- Pure AMOLED -->
        <div class="p-4 rounded-xl bg-zinc-950 border border-white/[0.08] space-y-3">
          <div class="w-full h-16 rounded-lg bg-[#000000] border border-white/10"></div>
          <div>
            <div class="text-xs font-bold text-white">Pure AMOLED</div>
            <div class="text-[11px] font-mono text-zinc-400">#000000</div>
            <div class="text-[10px] text-zinc-500 mt-1">Infinite canvas black</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 3: Typography -->
    <section class="space-y-6">
      <div>
        <h2 class="text-xl font-bold text-white">Typography System</h2>
        <p class="text-xs text-zinc-400">Two font families designed for high-density esports data display.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-2xl bg-zinc-950 border border-white/[0.08] space-y-3">
          <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider">UI & Headings</span>
          <h3 class="text-2xl font-extrabold text-white">Plus Jakarta Sans</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            A geometric sans-serif tailored for clean visual hierarchy, modern UI chrome, and high-readability scorecards.
          </p>
          <div class="pt-2 text-sm font-semibold text-zinc-300">
            Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz 0123456789
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-zinc-950 border border-white/[0.08] space-y-3">
          <span class="text-xs font-bold text-cyan-400 uppercase tracking-wider font-mono">Numbers & Telemetry</span>
          <h3 class="text-2xl font-bold text-white font-mono">JetBrains Mono</h3>
          <p class="text-xs text-zinc-400 leading-relaxed">
            Engineered for tabular alignment, round timers, steam IDs, rating decimal columns, and precision aim metrics.
          </p>
          <div class="pt-2 text-sm font-mono text-zinc-300">
            163.5 ADR · 2.40 RATING · 100% KAST · 14.510 RATING · 00:00 UTC
          </div>
        </div>
      </div>
    </section>

    <!-- Section 4: Brand Rules -->
    <section class="p-6 rounded-2xl bg-zinc-950 border border-white/[0.08] space-y-4">
      <h2 class="text-lg font-bold text-white">Design & Usage Principles</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-zinc-400 leading-relaxed">
        <div class="flex items-start gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Maintain minimum 24px of clear space around the radar lockup.</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>Use Tactical Emerald (<code>#10b981</code>) exclusively for primary status and live indicators.</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-red-400 font-bold">✕</span>
          <span>Do NOT distort, skew, or rotate the reticle crosshair ticks.</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-red-400 font-bold">✕</span>
          <span>Do NOT apply 3D drop-shadows, bevels, or skeuomorphic textures.</span>
        </div>
      </div>
    </section>
  </main>
</Layout>
