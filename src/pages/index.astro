---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LootFlowTracker from '../components/LootFlowTracker.astro';
import QuickLookHub from '../components/QuickLookHub.astro';
import MatchScorecardModal from '../components/MatchScorecardModal.astro';
import AuthModal from '../components/AuthModal.astro';
import SettingsModal from '../components/SettingsModal.astro';
---

<Layout
  title="CS2Live — CS2 Prime Drop Tracker, Farm ROI & Hacker Radar"
  description="LootFlow 2.0 multi-account CS2 Prime drop tracker, payback ROI analytics, care package reset countdown, and live match player hacker radar."
  canonical="https://cs2live.top/"
>
  <!-- Navbar -->
  <Navbar />

  <!-- Main Dashboard Viewport -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-8 space-y-6 sm:space-y-8">
    <!-- View Switcher Bar -->
    <div class="p-1.5 rounded-2xl bg-[#11161d] border border-white/[0.08] flex items-center gap-1.5 max-w-md mx-auto sm:mx-0 shadow-lg">
      <button
        id="btn-mode-lootflow"
        class="flex-1 px-4 py-2 rounded-xl text-xs sm:text-sm font-extrabold transition flex items-center justify-center gap-2 cursor-pointer bg-emerald-400 text-black glow-emerald"
      >
        <span class="text-base">🎁</span>
        <span>LootFlow Drop Tracker</span>
      </button>
      <button
        id="btn-mode-quicklook"
        class="flex-1 px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition flex items-center justify-center gap-2 cursor-pointer text-zinc-400 hover:text-white"
      >
        <span class="text-base">🎯</span>
        <span>Player Radar & Intel</span>
      </button>
    </div>

    <!-- View 1: LootFlow Drop Tracker Dashboard (Active Default) -->
    <div id="view-lootflow-tracker" class="space-y-6">
      <LootFlowTracker />
    </div>

    <!-- View 2: Quick Look Player, 360 Drop Intel & Match Radar -->
    <div id="view-quicklook-radar" class="space-y-6 hidden">
      <QuickLookHub />
    </div>
  </main>

  <!-- Footer -->
  <footer class="mt-12 sm:mt-16 border-t border-white/[0.08] bg-zinc-950/80 backdrop-blur-md py-6 sm:py-8 text-xs text-zinc-400">
    <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-4 sm:gap-6">
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <div class="flex items-center gap-2">
          <img src="/logo-icon.svg" alt="CS2Live" class="w-5 h-5" />
          <span class="font-extrabold text-white">CS2<span class="text-emerald-400">LIVE</span></span>
          <span class="text-zinc-600">·</span>
          <span class="font-mono text-zinc-400">cs2live.top</span>
        </div>
        <div class="flex items-center gap-3 text-[11px] text-zinc-400">
          <a href="/brand" class="hover:text-emerald-400 transition underline underline-offset-4">Brandkit & Assets</a>
          <span>·</span>
          <a href="/sitemap.xml" class="hover:text-emerald-400 transition">Sitemap</a>
          <span>·</span>
          <a href="/llms.txt" class="hover:text-emerald-400 transition">llms.txt</a>
          <span>·</span>
          <a href="/api/cs2/scavenger" target="_blank" class="hover:text-emerald-400 transition">Live API</a>
        </div>
      </div>
      <p class="text-zinc-500 text-[11px] text-center md:text-right max-w-lg">
        CS2Live is an independent analytics platform. Counter-Strike and Steam are registered trademarks of Valve Corporation. Match data scavenged and verified via CSTracker.gg & csst.at.
      </p>
    </div>
  </footer>

  <!-- Modals -->
  <AuthModal />
  <MatchScorecardModal />
  <SettingsModal />

  <!-- Client-side script initialization -->
  <script>
    import { initDashboard } from '../scripts/dashboard-app';
    document.addEventListener('DOMContentLoaded', () => {
      initDashboard();
    });
  </script>
</Layout>
