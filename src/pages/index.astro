---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ResetCountdown from '../components/ResetCountdown.astro';
import StatsOverview from '../components/StatsOverview.astro';
import ControlsBar from '../components/ControlsBar.astro';
import AccountContainer from '../components/AccountContainer.astro';
import MarketTicker from '../components/MarketTicker.astro';
import LiveMatches from '../components/LiveMatches.astro';
import ProLeaderboard from '../components/ProLeaderboard.astro';
import PlayerCommandCenter from '../components/PlayerCommandCenter.astro';
import HackerRadar from '../components/HackerRadar.astro';
import WeeklyDropRadar from '../components/WeeklyDropRadar.astro';
import MatchScorecardModal from '../components/MatchScorecardModal.astro';
import AuthModal from '../components/AuthModal.astro';
import AddAccountModal from '../components/AddAccountModal.astro';
import EditAccountModal from '../components/EditAccountModal.astro';
import LogMatchModal from '../components/LogMatchModal.astro';
import SettingsModal from '../components/SettingsModal.astro';
import Icons from '../components/Icons.astro';
---

<Layout
  title="CS2Live — CS2 Live Stats Tracker, Match Hacker Radar & Drop Intel"
  description="Counter-Strike 2 live intelligence command center. Real-time cheater detection radar, 10-player match scorecards, automated weekly care package drop reset countdown, and Steam inventory XP audit."
  canonical="https://cs2live.top/"
>
  <!-- Navbar -->
  <Navbar />

  <!-- Main Dashboard Viewport -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-8">
    <!-- Live Weekly Drop Pool Market Prices Ticker -->
    <MarketTicker />

    <!-- SECTION 0: TheKugelBlitz / greatmahakaal Spotlight Command Center -->
    <PlayerCommandCenter />

    <!-- SECTION 1: Hacker & Cheater Prediction Radar -->
    <HackerRadar />

    <!-- SECTION 1.5: 360-Degree Drop & XP Radar -->
    <WeeklyDropRadar />

    <!-- SECTION 2: Fleet Radar (Accounts, Reset Countdown, XP) -->
    <div id="section-fleet" class="space-y-6 hidden">
      <!-- Live Weekly Care Package Reset Countdown -->
      <ResetCountdown />

      <!-- Fleet Metrics Overview -->
      <StatsOverview />

      <!-- Filters, Search & Bulk Actions Bar -->
      <ControlsBar />

      <!-- Accounts Cards & Table Views -->
      <AccountContainer />
    </div>

    <!-- SECTION 3: Live CS2 Pro Match Tracker -->
    <LiveMatches />

    <!-- SECTION 4: World Pro Leaderboard & Ratings -->
    <ProLeaderboard />

    <!-- Informational CS2 Drop & XP Rules Section -->
    <section class="mt-12 pt-8 border-t border-white/[0.08] text-zinc-400">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="p-5 rounded-2xl bg-surface-1 border border-white/[0.06]">
          <div class="flex items-center gap-2 text-white font-bold text-sm mb-2">
            <Icons name="drop-box" class="w-4 h-4 text-emerald-400" />
            <span>Weekly Care Package</span>
          </div>
          <p class="text-xs leading-relaxed text-zinc-400">
            Earn ~5,000 XP in a week to rank up and claim your Care Package. You get to choose 2 items out of 4 (typically a Weapon Case, Weapon Skin, or Graffiti). Unclaimed drops do not roll over!
          </p>
        </div>

        <!-- Card 2 -->
        <div class="p-5 rounded-2xl bg-surface-1 border border-white/[0.06]">
          <div class="flex items-center gap-2 text-white font-bold text-sm mb-2">
            <Icons name="xp" class="w-4 h-4 text-cyan-400" />
            <span>XP Bonus & Reduced Penalties</span>
          </div>
          <p class="text-xs leading-relaxed text-zinc-400">
            Each week begins with <strong>Overachieving Bonus XP</strong> (~3x-4x multiplier). Once you surpass 11,167 XP in a single week, a severe <strong>Reduced XP gain (0.175x)</strong> is applied until Wednesday reset.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="p-5 rounded-2xl bg-surface-1 border border-white/[0.06]">
          <div class="flex items-center gap-2 text-white font-bold text-sm mb-2">
            <Icons name="medal" class="w-4 h-4 text-purple-400" />
            <span>Service Medals & Prestige</span>
          </div>
          <p class="text-xs leading-relaxed text-zinc-400">
            Upon reaching <strong>Profile Rank 40 (Global General)</strong>, you can reset your rank to 1 to claim the current calendar year Service Medal or upgrade its color tier (Tier 1 Grey up to Tier 6 Ruby Red).
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="mt-16 border-t border-white/[0.08] bg-zinc-950/80 backdrop-blur-md py-8 text-xs text-zinc-400">
    <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <div class="flex items-center gap-2">
          <img src="/logo-icon.svg" alt="CS2Live" class="w-5 h-5" />
          <span class="font-extrabold text-white">CS2<span class="text-emerald-400">LIVE</span></span>
          <span class="text-zinc-600">·</span>
          <span class="font-mono text-zinc-400">cs2live.top</span>
        </div>
        <div class="flex items-center gap-3 text-[11px] text-zinc-400">
          <a href="/brand" class="hover:text-emerald-400 transition underline underline-offset-4">Brandkit & Assets</a>
          <span>·</span>
          <a href="/sitemap.xml" class="hover:text-emerald-400 transition">Sitemap</a>
          <span>·</span>
          <a href="/llms.txt" class="hover:text-emerald-400 transition">llms.txt</a>
          <span>·</span>
          <a href="/api/cs2/scavenger" target="_blank" class="hover:text-emerald-400 transition">Live API</a>
        </div>
      </div>
      <p class="text-zinc-500 text-[11px] text-center md:text-right max-w-lg">
        CS2Live is an independent analytics platform. Counter-Strike and Steam are registered trademarks of Valve Corporation. Match data scavenged and verified via CSTracker.gg & csst.at.
      </p>
    </div>
  </footer>

  <!-- Modals -->
  <AuthModal />
  <AddAccountModal />
  <EditAccountModal />
  <LogMatchModal />
  <SettingsModal />
  <MatchScorecardModal />

  <!-- Client-side script initialization -->
  <script>
    import { initDashboard } from '../scripts/dashboard-app';
    document.addEventListener('DOMContentLoaded', () => {
      initDashboard();
    });
  </script>
</Layout>
